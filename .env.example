# Notion integration token (internal integration, workspace-scoped)
# Create at: https://www.notion.so/profile/integrations
NOTION_TOKEN=secret_...

# Notion DATA-SOURCE IDs (not parent DB IDs).
# Each database's data-source ID is found in the <data-source url="collection://..."> tag
# returned by notion.databases.retrieve(). Store the UUID portion only.
#
# Discovered via Notion MCP inspection on 2026-04-12:
NOTION_DEALFLOW_DB=6abacccb-e24b-46c6-9f9f-6a2a3cfc9a0f
NOTION_SIGNAL_DB=d67eb9f0-8bcf-443f-ba4f-2b528c4a6cb1
NOTION_THESIS_PACK_PAGE=973bfd70-26b4-4111-9d88-f633e641c186
NOTION_BLOG_DB=c4877a04-08c7-45a1-b18c-f9bd9fe1440e

# Optional: site URL used for absolute OG/canonical metadata
NEXT_PUBLIC_SITE_URL=http://localhost:3000
